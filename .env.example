# Zoho Mail SMTP Configuration for Contact Form
# Copy this file to .env.local and fill in your actual credentials

# SMTP Server Configuration
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=587

# Zoho Mail Email Account (your Zoho email address)
ZOHO_USER=vtp-team@visionarygroup.io

# App-specific password generated from Zoho Mail settings
# DO NOT use your main password for security reasons
ZOHO_SMTP_PASS=your-zoho-app-password

# Email address to send form submissions from (usually your Zoho email)
ZOHO_EMAIL_FROM=your-zoho-email@zoho.com

# Email address where form submissions will be received
CONTACT_EMAIL_TO=info@visionarygroup.io

# Optional: Email address for testing (development only)
# CONTACT_EMAIL_TEST=test@example.com
